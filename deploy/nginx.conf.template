# Rendered by the nginx image's entrypoint; ${PORT} comes from Cloud Run.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    # Cloud Run terminates TLS in front of us; never leak the container port in redirects.
    absolute_redirect off;
    port_in_redirect off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css text/markdown application/javascript application/json image/svg+xml;

    # Vite fingerprints everything under /assets, so it can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    # Instructions fetched by the AI generals at runtime.
    location = /llm_instruction.md {
        default_type text/markdown;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
    }

    # Single-page app: unknown paths fall back to index.html, which is never cached
    # so a new deploy is picked up immediately.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff";
        add_header Referrer-Policy "strict-origin-when-cross-origin";
    }
}
